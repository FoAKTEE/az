# knobs_option_C.env -- CANDIDATE, NOT APPLIED. node arxiv-1902.10565::scale_data_window,
# obligation o47_rows_per_game_drift_rederive_at_17.
#
# OPTION C: the combination, and the RECOMMENDED point. E = 16000 AND G = 1800.
# Changes against codes/loop/knobs_9x9.env (sha256 3504a8ea9c9d0bfa9), four lines:
#   NUM_GAMES_PER_CYCLE           1500 ->  1800
#   NUM_TRAIN_SAMPLES_PER_EPOCH  20000 -> 16000   (= 125 * BATCHSIZE)
#   NUM_TRAIN_SAMPLES_PER_SWA    10000 ->  8000   (= E//2, train.py:441 made explicit)
#   MAX_TRAIN_SAMPLES_PER_CYCLE 100000 -> 80000   (= 5*E, upstream's cap/epoch ratio held)
# EPOCHS_PER_EXPORT stays 5 = floor(min(gain, max(cap,E))/E); SHUFFLE_KEEPROWS stays
# 120000 (K3: 120000 > 80000 >= 80000); SHUFFLE_MINROWS, TAPER_WINDOW_SCALE, BATCHSIZE,
# MAX_TRAIN_PER_DATA and the two allocation knobs are unchanged.
#
# WHY BOTH LEVERS, and why G = 1800 rather than the 1500 of the E-only variant:
# the production log measures that NUM_TRAIN_SAMPLES_PER_EPOCH does not set what an epoch
# trains. shuffle.sh:48 writes the kept sample as round(SHUFFLE_KEEPROWS/70000) = 2 output
# files (measured 60136 and 59864 rows on 2026-09-05T05:54), and
# train.py:1306-1345 takes WHOLE files: the probabilistic skip at :1332 needs
# batches_to_use_so_far > 0, which a first file of 468 batches never allows. Measured, at
# E = 20000 = 156 nominal batches: 6557440 -> 6617216 -> 6677248 global-step samples, i.e.
# 467 and 469 batches, two epochs, then "Not enough data files to fill a subepoch".
# So samples/cycle = SHUFFLE_KEEPROWS, and the reuse the loop really applies is
#   rho = SHUFFLE_KEEPROWS / (G * r) = 120000 / (1500*17.7235) = 4.51 today,
# rising to 5.33 at r = 15 and 6.15 at r = 13, against the MAX_TRAIN_PER_DATA cap of 8.
# Lowering E alone moves the written T1 and leaves rho untouched; raising G is what moves
# rho. G = 1800 restores rho = 3.76, its value before the drift, and E = 16000 buys the
# written T1 the headroom that G alone does not: T1 fails again only at
#   r = 1.2*E/G + 10*|slope| = 19200/1800 + 1.070 = 11.737 rows/game,
# i.e. 55.9 accepted nets (~162 cycles) at the read-5 fitted slope -0.1070, 36.2 nets at
# o47's pessimistic -0.1528.
#
# 16000 = 125 * BATCHSIZE keeps 25 batches of margin over the 100-batch metrics floor of
# train.py:1379/:1661 even if the shuffled sample ever splits fine enough for E to bind.
# COST: selfplay 857.7 -> 1029.2 s per cycle (+20.0 %); the measured-basis cycle
# 928.5 -> 1090.4 s (+17.4 %); storage 15.13 -> 17.50 MiB/cycle (+15.7 %).
# Verify with:
#   python3 codes/eval/check_knobs_9x9.py \
#     --knobs evidence/scale_data_window/knobs_option_C.env \
#     --throughput evidence/production_chain/throughput.json \
#     --rows-file  evidence/production_chain/rows_per_game.txt \
#     --marginal-nets 3 --trend-nets 9 --horizon-nets 10

NUM_GAMES_PER_CYCLE=1800
NUM_THREADS_FOR_SHUFFLING=8
NUM_TRAIN_SAMPLES_PER_EPOCH=16000
MAX_TRAIN_PER_DATA=8
NUM_TRAIN_SAMPLES_PER_SWA=8000
BATCHSIZE=128
SHUFFLE_MINROWS=25000
MAX_TRAIN_SAMPLES_PER_CYCLE=80000
TAPER_WINDOW_SCALE=50000
SHUFFLE_KEEPROWS=120000
EPOCHS_PER_EXPORT=5
KTG_CPUS_PER_TASK=32
KTG_NUM_GAME_THREADS=18
