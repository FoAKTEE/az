# knobs_option_B.env -- CANDIDATE, NOT APPLIED. node arxiv-1902.10565::scale_data_window,
# obligation o47_rows_per_game_drift_rederive_at_17.
#
# OPTION B: hold the games at G = 1500 and take the epoch down to its floor.
# Changes against codes/loop/knobs_9x9.env (sha256 3504a8ea9c9d0bfa9), four lines:
#   NUM_TRAIN_SAMPLES_PER_EPOCH  20000 -> 12800
#   NUM_TRAIN_SAMPLES_PER_SWA    10000 ->  6400   (= E//2, train.py:441 default made explicit)
#   MAX_TRAIN_SAMPLES_PER_CYCLE 100000 -> 64000   (= 5*E, upstream's cap/epoch ratio held)
#   EPOCHS_PER_EXPORT                5 ->     5   (unchanged; floor(min(gain,cap_eff)/E))
# NUM_GAMES_PER_CYCLE, SHUFFLE_KEEPROWS, SHUFFLE_MINROWS, TAPER_WINDOW_SCALE, BATCHSIZE,
# MAX_TRAIN_PER_DATA and the two allocation knobs are UNCHANGED.
#
# 12800 = 100 * BATCHSIZE is the NOMINAL metrics-logging floor: train.py:1379 sets
# print_train_loss_every_batches = 100 and :1661 writes a metrics_train.json line only on
# batch_count_this_epoch % 100 == 0, with batch_count_this_epoch reset per epoch at :1478
# and sub_epochs = 1 (:94), so round(E/128) = 100 batches yields exactly one line and any E
# below 12800 yields none. o47_options.md section 3 measures that the floor is currently
# UNREACHABLE -- one shuffled output file carries 467 batches, so an epoch logs 4 lines
# whatever E is -- which makes B's zero margin over the floor latent rather than active. It
# becomes active the moment SHUFFLE_KEEPROWS is lowered enough to split the sample finer.
#
# SHUFFLE_KEEPROWS is deliberately NOT scaled with the cap: K3 needs only keep > cap and
# keep >= epochs*E (120000 > 64000 >= 64000). Note that o47_options.md section 3 measures
# samples/cycle = SHUFFLE_KEEPROWS, not epochs*E, so this option does NOT change the reuse
# the loop really applies (rho = keep/(G*r) = 4.51, unchanged); it restores the WRITTEN T1.
#
# T1 then fails again only when the marginal falls to 1.2*E/G + 10*|slope|
#   = 15360/1500 + 1.070 = 11.310 rows/game, i.e. 59.9 accepted nets of headroom
# at the read-5 fitted slope -0.1070 (39.0 nets at o47's pessimistic -0.1528).
# Verify with:
#   python3 codes/eval/check_knobs_9x9.py \
#     --knobs evidence/scale_data_window/knobs_option_B.env \
#     --throughput evidence/production_chain/throughput.json \
#     --rows-file  evidence/production_chain/rows_per_game.txt \
#     --marginal-nets 3 --trend-nets 9 --horizon-nets 10

NUM_GAMES_PER_CYCLE=1500
NUM_THREADS_FOR_SHUFFLING=8
NUM_TRAIN_SAMPLES_PER_EPOCH=12800
MAX_TRAIN_PER_DATA=8
NUM_TRAIN_SAMPLES_PER_SWA=6400
BATCHSIZE=128
SHUFFLE_MINROWS=25000
MAX_TRAIN_SAMPLES_PER_CYCLE=64000
TAPER_WINDOW_SCALE=50000
SHUFFLE_KEEPROWS=120000
EPOCHS_PER_EXPORT=5
KTG_CPUS_PER_TASK=32
KTG_NUM_GAME_THREADS=18
