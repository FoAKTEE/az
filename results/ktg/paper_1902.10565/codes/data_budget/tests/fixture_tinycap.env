# node data_budget - the mission's storage constants, single source of truth.
# Sourced by scratch_guard.sh and prune_retention.py; grep-asserted by the loop wrapper.
# All values are EXACT BYTE INTEGERS. Never write a threshold in decimal GB or as a float.
#
# Authority: mission.json `decisions` 2026-09-03 (human): "scratch budget for selfplay data
# + checkpoints = 500 GiB", affects node data_budget / obligation o04_scratch_budget.

# --- mission-root budget -----------------------------------------------------
# Scope is the MISSION ROOT (venv + build + loop data), never BASEDIR alone.
# PINNED (o28): a literal, never ${KTG_SCRATCH_ROOT:-...}. scratch_guard.sh REFUSES (exit 3)
# a constants file whose KTG_* values carry a ${...} indirection; prune_retention.py accepts
# one but resolves it to the file's default branch and prints a NOTE, never consulting the
# environment. Either way an exported KTG_SCRATCH_ROOT cannot redirect the measured root;
# only an explicit --root does, and both tools then print a NOTE naming this file's root.
KTG_SCRATCH_ROOT=/scratch/schmidt/ssci-anima/ssci-haiyangw/ktg-train

# 500 GiB = 500 * 2^30. Hard cap: a projected write crossing this aborts the cycle.
KTG_SCRATCH_HARD_BYTES=1000000   # FIXTURE: 1 MB cap, already exceeded, forces exit 1 at zero projection

# 20 GiB = 20 * 2^30. Bytes the guard assumes the next cycle will write when the caller
# does not pass --projected-bytes. Gives an effective soft cap of 480 GiB
# (515396075520 B): at or above it, no new cycle starts.
# PINNED (o28): a literal. The projection can only be changed by an explicit
# --projected-bytes argument from the caller; an exported KTG_CYCLE_PROJECTED_BYTES=0
# no longer zeroes it.
KTG_CYCLE_PROJECTED_BYTES=21474836480

# --- group-scratch safety margin ---------------------------------------------
# /scratch/ssci-anima is a 40 TB pool shared by the whole group and was at 94% when this
# guard was written; docs/cluster-manual.md §4 trap 1: at that level writes start failing
# for every group member, not just this mission.
#
# FAIL floor = 1 TiB = 2 * the mission's entire 500 GiB budget. Justification: even if this
# mission still had its whole budget unspent, spending all of it could not take the group
# below zero, and an equal share would remain for the rest of the group. So the mission can
# never be the writer that fills the pool.
KTG_GROUP_FREE_FAIL_BYTES=1099511627776

# WARN floor = 1.5 TiB = FAIL floor + one whole mission budget, so the warning arrives a
# full budget's worth of headroom before the hard floor. Warning does not abort.
KTG_GROUP_FREE_WARN_BYTES=1649267441664

# --- retention bounds (prune_retention.py) -----------------------------------
# longterm_checkpoints: python/train.py:1883-1889 writes one .ckpt every 12 h and nothing
# upstream ever removes them.
KTG_KEEP_LONGTERM_CHECKPOINTS=6
# rejectedmodels: the gatekeeper moves every rejected candidate here; nothing prunes it.
KTG_KEEP_REJECTED_MODELS=10
# shuffleddata: newest N dirs older than 2 h, matching python/selfplay/cleanup_old_dirs.py:24.
KTG_KEEP_SHUFFLEDDATA=3
KTG_SHUFFLEDDATA_MIN_AGE_S=7200
# scripts/dated/<ts>: one archive per resubmit, each carrying a katago binary.
KTG_KEEP_DATED_SCRIPTS=3
# selfplay/<model>/ generations kept regardless of the shuffle window.
KTG_KEEP_SELFPLAY_GENERATIONS=3
